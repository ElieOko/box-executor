{
  "version": 2,
  "agent": {
    "name": "HOSHI",
    "description": "Agent vocal réactif — WhatsApp planifié, digest Hacker News, automatisation UI",
    "workflows": [
      {
        "id": "whatsapp_scheduled_send",
        "name": "WhatsApp planifié HOSHI",
        "description": "Ouvre WhatsApp et envoie votre message à l'heure configurée",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_SCHEDULE",
            "label": "Déclencheur horaire",
            "config": { "scheduleId": "whatsapp_daily" },
            "positionX": 60,
            "positionY": 100
          },
          {
            "id": "n1",
            "type": "WHATSAPP_PREPARE",
            "label": "Votre message",
            "config": {
              "phone": "+33600000000",
              "message": "Message HOSHI à {{time}}"
            },
            "positionX": 280,
            "positionY": 100
          },
          {
            "id": "n2",
            "type": "WHATSAPP_OPEN",
            "label": "Ouvrir WhatsApp",
            "config": { "autoSend": "false" },
            "positionX": 500,
            "positionY": 100
          },
          {
            "id": "n2b",
            "type": "WHATSAPP_SEND_ACCESSIBILITY",
            "label": "Envoi auto UI",
            "config": { "enabled": "true", "waitMs": "2500" },
            "positionX": 720,
            "positionY": 100
          },
          {
            "id": "n3",
            "type": "SPEAK",
            "label": "Confirmation HOSHI",
            "config": { "text": "WhatsApp traité." },
            "positionX": 940,
            "positionY": 100
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n2b" },
          { "id": "e4", "fromNodeId": "n2b", "toNodeId": "n3" }
        ]
      },
      {
        "id": "hn_daily_digest",
        "name": "Digest Hacker News",
        "description": "Actualités depuis https://news.ycombinator.com/",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_SCHEDULE",
            "label": "Planification HN",
            "config": { "scheduleId": "hn_daily" },
            "positionX": 60,
            "positionY": 300
          },
          {
            "id": "n1",
            "type": "HTTP_FETCH",
            "label": "Page HN",
            "config": {
              "url": "https://news.ycombinator.com/",
              "method": "GET"
            },
            "positionX": 280,
            "positionY": 300
          },
          {
            "id": "n2",
            "type": "PARSE_HN_DIGEST",
            "label": "Top 5 titres",
            "config": { "limit": "5" },
            "positionX": 500,
            "positionY": 300
          },
          {
            "id": "n3",
            "type": "NOTIFY",
            "label": "Notification",
            "config": {
              "title": "HOSHI · Hacker News {{date}}",
              "body": "{{digest}}"
            },
            "positionX": 720,
            "positionY": 300
          },
          {
            "id": "n4",
            "type": "SPEAK",
            "label": "Lecture HOSHI",
            "config": {
              "text": "Voici l'actualité Hacker News. {{digest_short}}"
            },
            "positionX": 940,
            "positionY": 300
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n3" },
          { "id": "e4", "fromNodeId": "n3", "toNodeId": "n4" }
        ]
      },
      {
        "id": "voice_launch_yvent",
        "name": "Lancer Yvent",
        "description": "Ouvre com.yvent.app dans la box",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande vocale",
            "config": { "phrase": "ouvrir yvent" },
            "positionX": 60,
            "positionY": 500
          },
          {
            "id": "n1",
            "type": "LAUNCH_APP",
            "label": "Yvent",
            "config": {
              "packageName": "com.yvent.app",
              "displayName": "Yvent",
              "inBox": "true"
            },
            "positionX": 320,
            "positionY": 500
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmation",
            "config": { "text": "J'ouvre Yvent." },
            "positionX": 580,
            "positionY": 500
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      }
    ],
    "schedules": [],
    "voiceCommands": [
      { "phrase": "envoie whatsapp", "workflowId": "whatsapp_scheduled_send", "parameters": { "immediate": "true" } },
      { "phrase": "envoyer whatsapp", "workflowId": "whatsapp_scheduled_send" },
      { "phrase": "digest hacker news", "workflowId": "hn_daily_digest" },
      { "phrase": "actualités", "workflowId": "hn_daily_digest" },
      { "phrase": "ouvrir yvent", "workflowId": "voice_launch_yvent" }
    ],
    "reactiveExpressions": [
      {
        "patterns": ["bonjour", "salut", "coucou"],
        "response": "Bonjour, je suis HOSHI. Je peux envoyer WhatsApp, lire Hacker News ou ouvrir Yvent."
      },
      {
        "patterns": ["comment ça va", "ca va", "comment vas-tu"],
        "response": "Tout va bien, je suis prête à vous aider."
      },
      {
        "patterns": ["merci", "thanks"],
        "response": "Avec plaisir."
      },
      {
        "patterns": ["quelle heure", "il est quelle heure"],
        "response": "Consultez l'heure sur votre écran, ou demandez-moi d'envoyer WhatsApp à une heure précise dans la configuration."
      },
      {
        "patterns": ["hacker news", "hn", "actualité", "actualites"],
        "workflowId": "hn_daily_digest"
      },
      {
        "patterns": ["whatsapp", "message"],
        "workflowId": "whatsapp_scheduled_send"
      },
      {
        "patterns": ["yvent", "ouvre l'application"],
        "workflowId": "voice_launch_yvent"
      }
    ],
    "eventTriggers": [
      { "topic": "hoshi.run", "workflowId": "hn_daily_digest" },
      { "topic": "agent.run", "workflowId": "hn_daily_digest" }
    ]
  }
}
