{
  "version": 4,
  "agent": {
    "name": "HOSHI",
    "description": "Assistant JARVIS autonome — HN temps réel (Firebase API), plateformes CasaNayo/Vehnix/Barua, overlay déplaçable",
    "workflows": [
      {
        "id": "whatsapp_scheduled_send",
        "name": "WhatsApp planifié HOSHI",
        "description": "Ouvre WhatsApp et envoie votre message à l'heure configurée (envoi auto UI)",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_SCHEDULE",
            "label": "Déclencheur horaire",
            "config": { "scheduleId": "whatsapp_daily" },
            "positionX": 60,
            "positionY": 100
          },
          {
            "id": "n1",
            "type": "WHATSAPP_PREPARE",
            "label": "Votre message",
            "config": {
              "phone": "+33600000000",
              "message": "Message HOSHI à {{time}}"
            },
            "positionX": 280,
            "positionY": 100
          },
          {
            "id": "n2",
            "type": "WHATSAPP_OPEN",
            "label": "Ouvrir WhatsApp",
            "config": { "autoSend": "true" },
            "positionX": 500,
            "positionY": 100
          },
          {
            "id": "n2b",
            "type": "WHATSAPP_SEND_ACCESSIBILITY",
            "label": "Envoi auto UI",
            "config": { "enabled": "true", "waitMs": "2500" },
            "positionX": 720,
            "positionY": 100
          },
          {
            "id": "n3",
            "type": "SPEAK",
            "label": "Confirmation HOSHI",
            "config": { "text": "WhatsApp traité, {{user_title}}." },
            "positionX": 940,
            "positionY": 100
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n2b" },
          { "id": "e4", "fromNodeId": "n2b", "toNodeId": "n3" }
        ]
      },
      {
        "id": "hn_daily_digest",
        "name": "Digest Hacker News",
        "description": "Actualités temps réel via API Firebase Hacker News, traduites EN→FR",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_SCHEDULE",
            "label": "Planification HN",
            "config": { "scheduleId": "hn_daily" },
            "positionX": 60,
            "positionY": 300
          },
          {
            "id": "n0",
            "type": "PLATFORM_STATUS_CHECK",
            "label": "Statut plateformes",
            "config": {},
            "positionX": 170,
            "positionY": 300
          },
          {
            "id": "n1",
            "type": "HTTP_FETCH",
            "label": "API HN temps réel",
            "config": {
              "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
              "method": "GET"
            },
            "positionX": 280,
            "positionY": 300
          },
          {
            "id": "n2",
            "type": "PARSE_HN_DIGEST",
            "label": "Top 5 titres",
            "config": { "limit": "5" },
            "positionX": 500,
            "positionY": 300
          },
          {
            "id": "n3",
            "type": "NOTIFY",
            "label": "Notification",
            "config": {
              "title": "HOSHI · Hacker News {{date}}",
              "body": "{{platform_status_short}}\n\n{{digest}}"
            },
            "positionX": 720,
            "positionY": 300
          },
          {
            "id": "n4",
            "type": "SPEAK",
            "label": "Lecture HOSHI",
            "config": {
              "text": "{{user_title}}, {{platform_status_short}} Voici l'actualité Hacker News en temps réel. {{digest_short}}"
            },
            "positionX": 940,
            "positionY": 300
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n0" },
          { "id": "e1b", "fromNodeId": "n0", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n3" },
          { "id": "e4", "fromNodeId": "n3", "toNodeId": "n4" }
        ]
      },
      {
        "id": "voice_launch_yvent",
        "name": "Lancer Yvent",
        "description": "Ouvre com.yvent.app sur l'appareil",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande vocale",
            "config": { "phrase": "ouvrir yvent" },
            "positionX": 60,
            "positionY": 500
          },
          {
            "id": "n1",
            "type": "LAUNCH_APP",
            "label": "Yvent",
            "config": {
              "packageName": "com.yvent.app",
              "displayName": "Yvent",
              "inBox": "false"
            },
            "positionX": 320,
            "positionY": 500
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmation",
            "config": { "text": "J'ouvre Yvent, {{user_title}}." },
            "positionX": 580,
            "positionY": 500
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      },
      {
        "id": "jarvis_morning_briefing",
        "name": "Briefing matinal JARVIS",
        "description": "Briefing proactif — actualités et statut système",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_SCHEDULE",
            "label": "Matin",
            "config": { "scheduleId": "jarvis_morning" },
            "positionX": 60,
            "positionY": 700
          },
          {
            "id": "n0",
            "type": "PLATFORM_STATUS_CHECK",
            "label": "CasaNayo · Vehnix · Barua",
            "config": {},
            "positionX": 170,
            "positionY": 700
          },
          {
            "id": "n1",
            "type": "HTTP_FETCH",
            "label": "API HN temps réel",
            "config": {
              "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
              "method": "GET"
            },
            "positionX": 280,
            "positionY": 700
          },
          {
            "id": "n2",
            "type": "PARSE_HN_DIGEST",
            "label": "Digest",
            "config": { "limit": "3" },
            "positionX": 500,
            "positionY": 700
          },
          {
            "id": "n3",
            "type": "NOTIFY",
            "label": "Notification briefing",
            "config": {
              "title": "Briefing HOSHI · {{date}}",
              "body": "{{platform_status_short}}\n\n{{digest_short}}"
            },
            "positionX": 720,
            "positionY": 700
          },
          {
            "id": "n4",
            "type": "SPEAK",
            "label": "Briefing vocal",
            "config": {
              "text": "Bonjour {{user_title}}. {{system_status_message}}. {{platform_status_short}} Actualités Hacker News en temps réel. {{digest_short}}"
            },
            "positionX": 940,
            "positionY": 700
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n0" },
          { "id": "e1b", "fromNodeId": "n0", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n3" },
          { "id": "e4", "fromNodeId": "n3", "toNodeId": "n4" }
        ]
      },
      {
        "id": "jarvis_read_screen",
        "name": "Lire l'écran",
        "description": "Lit le contenu visible via Accessibilité HOSHI",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande",
            "config": {},
            "positionX": 60,
            "positionY": 900
          },
          {
            "id": "n1",
            "type": "UI_READ_SCREEN",
            "label": "Lecture écran",
            "config": { "maxChars": "2000" },
            "positionX": 280,
            "positionY": 900
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Analyse vocale",
            "config": {
              "text": "{{user_title}}, voici ce que je vois à l'écran. {{screen_preview}}"
            },
            "positionX": 500,
            "positionY": 900
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      },
      {
        "id": "whatsapp_group_broadcast",
        "name": "WhatsApp groupe personnalisé",
        "description": "Envoie un message personnalisé IA à chaque contact du groupe",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande groupe",
            "config": {},
            "positionX": 60,
            "positionY": 1100
          },
          {
            "id": "n1",
            "type": "WHATSAPP_BROADCAST",
            "label": "Broadcast IA",
            "config": { "delayBetweenMs": "4000" },
            "positionX": 300,
            "positionY": 1100
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmation",
            "config": {
              "text": "{{user_title}}, messages personnalisés envoyés à {{broadcast_sent}} contacts sur {{broadcast_total}}."
            },
            "positionX": 560,
            "positionY": 1100
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      },
      {
        "id": "launch_any_app",
        "name": "Ouvrir une application système",
        "description": "Lance une app installée sur l'appareil par son nom vocal",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande app",
            "config": {},
            "positionX": 60,
            "positionY": 1300
          },
          {
            "id": "n1",
            "type": "LAUNCH_APP_BY_NAME",
            "label": "Ouvrir app",
            "config": { "inBox": "false", "appName": "{{app_name}}" },
            "positionX": 300,
            "positionY": 1300
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmé",
            "config": { "text": "Application ouverte, {{user_title}}." },
            "positionX": 560,
            "positionY": 1300
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      },
      {
        "id": "launch_appbox_catalog",
        "name": "Ouvrir app catalogue AppBox",
        "description": "Lance une app ajoutée dans l'UI AppBox par son nom — ouverture système",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande catalogue",
            "config": {},
            "positionX": 60,
            "positionY": 1500
          },
          {
            "id": "n1",
            "type": "LAUNCH_APP_BY_NAME",
            "label": "Catalogue AppBox",
            "config": { "inBox": "false", "appName": "{{app_name}}" },
            "positionX": 300,
            "positionY": 1500
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmé",
            "config": {
              "text": "J'ouvre {{app_name}}, {{user_title}}."
            },
            "positionX": 560,
            "positionY": 1500
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      },
      {
        "id": "platform_status_check",
        "name": "Statut plateformes",
        "description": "Vérifie CasaNayo, Vehnix Auto et Barua Officiel",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande statut",
            "config": {},
            "positionX": 60,
            "positionY": 1900
          },
          {
            "id": "n1",
            "type": "PLATFORM_STATUS_CHECK",
            "label": "Vérification HTTP",
            "config": {},
            "positionX": 300,
            "positionY": 1900
          },
          {
            "id": "n2",
            "type": "NOTIFY",
            "label": "Notification statut",
            "config": {
              "title": "HOSHI · Plateformes",
              "body": "{{platform_status}}"
            },
            "positionX": 540,
            "positionY": 1900
          },
          {
            "id": "n3",
            "type": "SPEAK",
            "label": "Rapport vocal",
            "config": {
              "text": "{{user_title}}, {{platform_status_short}}"
            },
            "positionX": 780,
            "positionY": 1900
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" },
          { "id": "e3", "fromNodeId": "n2", "toNodeId": "n3" }
        ]
      },
      {
        "id": "open_system_app",
        "name": "Ouvrir réglages système",
        "description": "Ouvre paramètres, Wi-Fi, Bluetooth ou accessibilité",
        "enabled": true,
        "nodes": [
          {
            "id": "t1",
            "type": "TRIGGER_VOICE",
            "label": "Commande système",
            "config": {},
            "positionX": 60,
            "positionY": 1700
          },
          {
            "id": "n1",
            "type": "OPEN_SYSTEM_APP",
            "label": "Réglages",
            "config": { "target": "{{app_target}}" },
            "positionX": 300,
            "positionY": 1700
          },
          {
            "id": "n2",
            "type": "SPEAK",
            "label": "Confirmé",
            "config": { "text": "Réglages ouverts, {{user_title}}." },
            "positionX": 560,
            "positionY": 1700
          }
        ],
        "edges": [
          { "id": "e1", "fromNodeId": "t1", "toNodeId": "n1" },
          { "id": "e2", "fromNodeId": "n1", "toNodeId": "n2" }
        ]
      }
    ],
    "schedules": [],
    "voiceCommands": [
      { "phrase": "envoie whatsapp", "workflowId": "whatsapp_scheduled_send", "parameters": { "immediate": "true" } },
      { "phrase": "envoyer whatsapp", "workflowId": "whatsapp_scheduled_send", "parameters": { "immediate": "true" } },
      { "phrase": "digest hacker news", "workflowId": "hn_daily_digest" },
      { "phrase": "actualités", "workflowId": "hn_daily_digest" },
      { "phrase": "ouvrir yvent", "workflowId": "voice_launch_yvent" },
      { "phrase": "lance yvent", "workflowId": "voice_launch_yvent" },
      { "phrase": "lis l'écran", "workflowId": "jarvis_read_screen" },
      { "phrase": "que vois-tu", "workflowId": "jarvis_read_screen" },
      { "phrase": "briefing", "workflowId": "jarvis_morning_briefing" },
      { "phrase": "briefing matinal", "workflowId": "jarvis_morning_briefing" },
      { "phrase": "envoie au groupe", "workflowId": "whatsapp_group_broadcast" },
      { "phrase": "message au groupe", "workflowId": "whatsapp_group_broadcast" },
      { "phrase": "ouvre", "workflowId": "launch_appbox_catalog" },
      { "phrase": "ouvrir", "workflowId": "launch_appbox_catalog" },
      { "phrase": "lance", "workflowId": "launch_appbox_catalog" },
      { "phrase": "lancer", "workflowId": "launch_appbox_catalog" },
      { "phrase": "ouvre les paramètres", "workflowId": "open_system_app", "parameters": { "app_target": "settings" } },
      { "phrase": "paramètres", "workflowId": "open_system_app", "parameters": { "app_target": "settings" } },
      { "phrase": "wifi", "workflowId": "open_system_app", "parameters": { "app_target": "wifi" } },
      { "phrase": "accessibilité", "workflowId": "open_system_app", "parameters": { "app_target": "accessibility" } },
      { "phrase": "statut plateformes", "workflowId": "platform_status_check" },
      { "phrase": "statut des plateformes", "workflowId": "platform_status_check" },
      { "phrase": "casanayo", "workflowId": "platform_status_check" },
      { "phrase": "vehnix", "workflowId": "platform_status_check" },
      { "phrase": "barua", "workflowId": "platform_status_check" },
      { "phrase": "les plateformes", "workflowId": "platform_status_check" }
    ],
    "reactiveExpressions": [
      {
        "patterns": ["bonjour", "salut", "coucou", "hello"],
        "response": "Bonjour {{user_title}}. Tous les systèmes sont opérationnels. Que puis-je faire pour vous ?"
      },
      {
        "patterns": ["comment ça va", "ca va", "comment vas-tu"],
        "response": "Tout va bien, je suis prête à vous aider."
      },
      {
        "patterns": ["merci", "thanks"],
        "response": "Avec plaisir, {{user_title}}."
      },
      {
        "patterns": ["quelle heure", "il est quelle heure"],
        "response": "Consultez l'heure sur votre écran, ou demandez-moi d'envoyer WhatsApp à une heure précise dans la configuration HOSHI."
      },
      {
        "patterns": ["hacker news", "hn", "actualité", "actualites", "actualités"],
        "workflowId": "hn_daily_digest"
      },
      {
        "patterns": ["whatsapp", "envoie un message"],
        "workflowId": "whatsapp_scheduled_send",
        "parameters": { "immediate": "true" }
      },
      {
        "patterns": ["yvent", "ouvre yvent"],
        "workflowId": "voice_launch_yvent"
      },
      {
        "patterns": ["groupe", "broadcast", "contacts"],
        "workflowId": "whatsapp_group_broadcast"
      },
      {
        "patterns": ["paramètres", "reglages", "réglages"],
        "workflowId": "open_system_app",
        "parameters": { "app_target": "settings" }
      },
      {
        "patterns": ["lis", "écran", "que vois"],
        "workflowId": "jarvis_read_screen"
      },
      {
        "patterns": ["casanayo", "vehnix", "barua", "plateforme", "plateformes", "statut", "système", "systeme"],
        "workflowId": "platform_status_check"
      }
    ],
    "eventTriggers": [
      { "topic": "hoshi.run", "workflowId": "hn_daily_digest" },
      { "topic": "agent.run", "workflowId": "hn_daily_digest" },
      { "topic": "hoshi.autonomous.briefing", "workflowId": "jarvis_morning_briefing" },
      { "topic": "hoshi.autonomous.digest", "workflowId": "hn_daily_digest" },
      { "topic": "hoshi.autonomous.whatsapp", "workflowId": "whatsapp_scheduled_send" },
      { "topic": "hoshi.autonomous.platforms", "workflowId": "platform_status_check" }
    ]
  }
}
